# Скопируйте этот файл в .env и заполните. Реальный .env в git не попадает (см. .gitignore).

# ---- Telegram ----
# Токен бота из @BotFather. Если не задан — оплата работает в demo-режиме.
# НИКОГДА не публикуйте реальный токен в git.
BOT_TOKEN=

# Цена размещения одной вакансии в Telegram Stars (целое число).
JOB_POST_PRICE_STARS=100

# Публичный HTTPS-адрес задеплоенного Mini App (для кнопки меню и команд бота).
# Пример: WEBAPP_URL=https://job-mini-app.vercel.app
WEBAPP_URL=

# ---- Telegram webhook (для облачного хостинга, например Render) ----
# Публичный HTTPS-адрес ЭТОГО бэкенда. Если пусто, берётся RENDER_EXTERNAL_URL.
# Пример: WEBHOOK_URL=https://itdev-backend.onrender.com
WEBHOOK_URL=
# Необязательный секрет вебхука (любая строка). Telegram будет присылать его
# в заголовке X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=

# ---- Supabase ----
# Project URL (Settings → API).
SUPABASE_URL=

# Публикуемый ключ (безопасен для клиента), используется как запасной вариант.
SUPABASE_ANON_KEY=

# СЕКРЕТНЫЙ ключ service_role (Settings → API → service_role).
# ОБЯЗАТЕЛЕН для записи в базу. НИКОГДА не публикуйте его во фронтенде.
# Можно заполнить автоматически командой `npm run db:setup`.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token Supabase — нужен только для `npm run db:setup`
# (применяет schema.sql и получает service_role). НЕ для работы приложения.
# Получить: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ---- Администрирование ----
# Telegram ID администраторов через запятую. Эти пользователи видят админ-раздел
# (управление вакансиями, жалобы, статистика) и получают флаг is_admin.
# Свой ID можно узнать у бота @userinfobot.
ADMIN_TELEGRAM_IDS=

# ---- Прочее ----
PORT=3000
# Разрешённый origin фронтенда для CORS ("*" — разрешить всем).
CORS_ORIGIN=*
# Разрешить вход без Telegram для локальной отладки (true/false).
ALLOW_DEV_LOGIN=false
