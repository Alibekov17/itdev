# Базовый URL задеплоенного бэкенда.
# В dev можно оставить пустым — запросы к /api проксируются на http://localhost:3000.
# В продакшене укажите адрес backend, например:
# VITE_API_BASE_URL=https://job-mini-app-backend.onrender.com
# Оставьте пустым для локальной разработки.
VITE_API_BASE_URL=

# Необязательно: ID пользователя для отладки в браузере без Telegram.
# Требует ALLOW_DEV_LOGIN=true на бэкенде. В продакшене не задавать.
# VITE_DEV_USER=1
